*.def
*.summary
~*.*

# Aspen 运行时残留
*.ktp
*.dfd
*.dpi
*.inm

# Aspen 引擎伴生文件（sim/ 下 _ 开头运行时文件 + 摘要文件 + 备份）
*.ads
*.sum
sim/_*
$*

# 临时诊断脚本（模型调试用，不入库）
runs/*/*.py

# IDE 配置
.vscode/

# 保留所有 .md / .json / .ps1 —— 方案、归因表、状态是本系统的真正资产
